# Pulsar 5 — copy to .env and fill in. Never commit .env.
# The NVIDIA API key does NOT belong here. It lives only inside Nightshift.

# ---- Zetaris (the only data layer) ----
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-password

# ---- Meterless Nightshift (the only model provider) ----
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
# Pin Nemotron-backed routes from GET /v1/models
METERLESS_MODEL_FAST=
METERLESS_MODEL_DEEP=
METERLESS_MODEL_JUDGE=

# ---- Runtime ----
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
UI_PORT=8501
MAX_REPLAN_ITERATIONS=3
LLM_TIMEOUT_SECONDS=60
ZETARIS_TIMEOUT_SECONDS=45
CONFIDENCE_ESCALATION_THRESHOLD=0.7
