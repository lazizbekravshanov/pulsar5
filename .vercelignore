# Secrets must never enter the function bundle. Vercel uploads from the working
# directory, not from git, so .gitignore does not protect this on its own.
.env
.env.*
!.env.example
*.key
*.pem

# Not needed at runtime
.venv
venv
tests
docs
logs
output_examples
scripts
.pytest_cache
__pycache__
*.pyc
.git
Dockerfile
.dockerignore
ui/index.html.bak
